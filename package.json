{
  "name": "qiming",
  "version": "0.1.0",
  "private": true,
  "description": "启明 —— 独立的本机智能体（TypeScript 后端 + React 前端）",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node server.ts",
    "dev": "node --watch server.ts",
    "build:ui": "node scripts/build-ui.mjs",
    "build:watch": "node scripts/build-ui.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\"",
    "ui-check": "node test/ui-check.mjs",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.16",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "gpt-tokenizer": "^4.0.0",
    "simple-git": "^4.0.2"
  }
}
